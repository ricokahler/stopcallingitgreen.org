---
import { chapterNumber, type ChapterMeta } from "../lib/chapters";

interface Props {
  previous: ChapterMeta | null;
  next: ChapterMeta | null;
}

const { previous, next } = Astro.props;
---

<nav class="chapter-next" aria-label="Chapter navigation">
  {next ? (
    <a class="next-card" href={`/chapters/${next.slug}/`} rel="next" data-next-link>
      <p class="eyebrow">Up next · {next.chapterLabel} <span class="dim">/ {chapterNumber(next)}</span></p>
      <strong>{next.title}</strong>
      <p>{next.description}</p>
      <span class="next-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </span>
    </a>
  ) : (
    <a class="next-card" href="/#chapters" rel="index" data-next-link>
      <p class="eyebrow">That's the book</p>
      <strong>Back to the table of contents</strong>
      <p>Reread a chapter, send one to someone, or open an issue if you caught a mistake.</p>
      <span class="next-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </span>
    </a>
  )}
  {previous && (
    <a class="prev-link" href={`/chapters/${previous.slug}/`} rel="prev" data-prev-link>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
      <span>Previous: {previous.shortTitle}</span>
    </a>
  )}
</nav>
