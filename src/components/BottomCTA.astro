---
interface Props {
  title?: string;
  body?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title = "Read it straight through.",
  body = "It's short on purpose. Start at the beginning, or jump to the chapter that already sounds like the argument you keep hearing.",
  primaryHref = "/chapters/introduction/",
  primaryLabel = "Start reading",
  secondaryHref = "/#chapters",
  secondaryLabel = "Browse chapters"
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div>
    <h2 id="cta-title">{title}</h2>
    <p>{body}</p>
  </div>
  <div class="cta-actions">
    <a class="button primary" href={primaryHref}>{primaryLabel}</a>
    <a class="button" href={secondaryHref}>{secondaryLabel}</a>
  </div>
</section>
