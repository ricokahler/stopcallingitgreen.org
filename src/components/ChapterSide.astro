---
import { chapters, chapterNumber, type ChapterMeta } from "../lib/chapters";

interface Props {
  chapter: ChapterMeta;
}

const { chapter } = Astro.props;
const index = chapters.findIndex((item) => item.slug === chapter.slug);
---

<aside class="reader-side" aria-label="Chapter navigation and outline">
  <div class="side-progress">
    <h2>Your place in the book</h2>
    <div class="side-progress-track" aria-hidden="true">
      {chapters.map((item, i) => (
        <a
          href={`/chapters/${item.slug}/`}
          title={`${item.chapterLabel}: ${item.shortTitle}`}
          aria-current={item.slug === chapter.slug ? "page" : undefined}
          data-done={i < index ? "" : undefined}
          data-track={item.slug}
        ></a>
      ))}
    </div>
    <p>{chapterNumber(chapter)} of {String(chapters.length - 1).padStart(2, "0")} · <a href="/#chapters">all chapters</a></p>
  </div>
  {chapter.headings.length > 0 && (
    <nav class="toc" aria-label="In this chapter" data-toc>
      <h2>In this chapter</h2>
      <ol>
        {chapter.headings.map((heading) => (
          <li><a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a></li>
        ))}
      </ol>
    </nav>
  )}
  <p class="side-shortcut"><kbd>←</kbd> <kbd>→</kbd> move between chapters</p>
</aside>
