---
const shareUrl = "https://stopcallingitgreen.org/";
const shareTitle = "Stop Calling It Green";
const shareText = "Cheap power got dragged into the culture war. A free, sourced online book.";
const encodedUrl = encodeURIComponent(shareUrl);
const encodedTitle = encodeURIComponent(shareTitle);
const encodedText = encodeURIComponent(`${shareTitle}: ${shareText}`);

const links = [
  { label: "X / Twitter", href: `https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}` },
  { label: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}` },
  { label: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
  { label: "Reddit", href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}` }
];
---

<section class="share" aria-labelledby="share-title">
  <div>
    <p class="eyebrow">Pass it along</p>
    <h2 id="share-title">Send it to the next person who says "green energy" like it's a trick.</h2>
    <p>No pitch, no pledge, no mailing list. The whole book is free, and the sources are at the bottom of every chapter.</p>
  </div>
  <div class="share-tools" aria-label="Share links">
    <button
      class="share-tool share-tool-primary"
      type="button"
      data-native-share
      data-share-url={shareUrl}
      data-share-title={shareTitle}
      data-share-text={shareText}
    >
      Share
      <span aria-hidden="true">↗</span>
    </button>
    <button class="share-tool" type="button" data-copy-share data-default-label="Copy link" data-share-url={shareUrl}>
      Copy link
    </button>
    {links.map((link) => (
      <a class="share-tool" href={link.href} target="_blank" rel="noopener noreferrer">
        {link.label}
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-native-share]").forEach((button) => {
      if (!("share" in navigator)) {
        button.hidden = true;
        return;
      }
      button.addEventListener("click", async () => {
        try {
          await navigator.share({
            title: button.dataset.shareTitle,
            text: button.dataset.shareText,
            url: button.dataset.shareUrl
          });
        } catch {}
      });
    });

    document.querySelectorAll("[data-copy-share]").forEach((button) => {
      const original = button.dataset.defaultLabel || "Copy link";
      const flash = (label) => {
        button.textContent = label;
        window.setTimeout(() => {
          button.textContent = original;
        }, 1600);
      };
      button.addEventListener("click", async () => {
        const url = button.dataset.shareUrl || window.location.href;
        try {
          if (!navigator.clipboard || !window.isSecureContext) throw new Error("clipboard unavailable");
          await navigator.clipboard.writeText(url);
          flash("Copied");
        } catch {
          flash("Copy manually");
          window.prompt("Copy this link", url);
        }
      });
    });
  })();
</script>
