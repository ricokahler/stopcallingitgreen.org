---
import "../styles/global.css";
import { chapters, chapterNumber, editionLabel, type ChapterMeta } from "../lib/chapters";

interface Props {
  title?: string;
  description?: string;
  pageKind?: "home" | "chapter" | "about" | "page";
  chapter?: ChapterMeta;
}

const {
  title,
  description = "A free online book about how cheap power got dragged into the culture war.",
  pageKind,
  chapter
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://stopcallingitgreen.org");
const pageTitle = title ? `${title} | Stop Calling It Green` : "Stop Calling It Green";
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const homeUrl = new URL("/", siteUrl).toString();
const bookId = new URL("/#book", siteUrl).toString();
const websiteId = new URL("/#website", siteUrl).toString();
const pageId = `${canonical}#webpage`;
const workId = `${canonical}#work`;
const socialImage = new URL("/og/stop-calling-it-green.png", siteUrl).toString();
const socialImageAlt =
  "Stop calling it green. It's just cheap power. A free online book about how solar, wind, and batteries got dragged into the culture war.";
const resolvedKind = pageKind ?? (chapter ? "chapter" : title ? "page" : "home");
const pageType = resolvedKind === "chapter" ? "article" : "website";
const chapterList = chapters.map((item) => ({
  "@type": "Chapter",
  "@id": new URL(`/chapters/${item.slug}/#work`, siteUrl).toString(),
  name: item.title,
  position: item.order,
  url: new URL(`/chapters/${item.slug}/`, siteUrl).toString(),
  description: item.description,
  isAccessibleForFree: true,
  inLanguage: "en-US"
}));
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
  ...(resolvedKind === "chapter" && chapter
    ? [{ "@type": "ListItem", position: 2, name: chapter.title, item: canonical }]
    : resolvedKind === "about"
      ? [{ "@type": "ListItem", position: 2, name: "About", item: canonical }]
      : [])
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "Stop Calling It Green",
      url: homeUrl,
      description: "A free online book about how cheap power got dragged into the culture war.",
      inLanguage: "en-US"
    },
    {
      "@type": "Book",
      "@id": bookId,
      name: "Stop Calling It Green",
      alternateName: "Stop Calling It Green: How Cheap Power Got Dragged Into The Culture War",
      url: homeUrl,
      description:
        "A free online book about solar, oil lobbying, energy propaganda, and why fuel-free power should be judged as infrastructure.",
      image: socialImage,
      isAccessibleForFree: true,
      inLanguage: "en-US",
      genre: ["Energy policy", "Infrastructure", "Long-form nonfiction"],
      hasPart: chapterList
    },
    {
      "@type": "WebPage",
      "@id": pageId,
      url: canonical,
      name: pageTitle,
      description,
      image: socialImage,
      isPartOf: { "@id": websiteId },
      inLanguage: "en-US",
      mainEntity:
        resolvedKind === "home" ? { "@id": bookId } : resolvedKind === "chapter" ? { "@id": workId } : undefined
    },
    ...(resolvedKind === "chapter" && chapter
      ? [
          {
            "@type": "Chapter",
            "@id": workId,
            name: chapter.title,
            headline: chapter.title,
            description: chapter.description,
            url: canonical,
            position: chapter.order,
            isPartOf: { "@id": bookId },
            isAccessibleForFree: true,
            inLanguage: "en-US",
            citation: chapter.sources.map((source) => ({
              "@type": "CreativeWork",
              name: source.title,
              url: source.url
            }))
          }
        ]
      : []),
    { "@type": "BreadcrumbList", "@id": `${canonical}#breadcrumb`, itemListElement: breadcrumbItems }
  ]
};
const currentSlug = chapter?.slug ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        let saved = null;
        try {
          saved = localStorage.getItem("scig-theme");
        } catch {}
        const mode = saved === "light" || saved === "dark" ? saved : "system";
        root.dataset.themeMode = mode;
        root.dataset.theme = mode === "system" ? (media.matches ? "dark" : "light") : mode;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="application-name" content="Stop Calling It Green" />
    <meta name="apple-mobile-web-app-title" content="Stop Calling It Green" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0f1218" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Stop Calling It Green" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-page={resolvedKind} data-chapter={currentSlug || undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-site-header>
      <div class="wrap site-header-inner">
        <a class="brand" href="/" aria-label="Stop Calling It Green home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M5.6 18.4l1.6-1.6M16.8 7.2l1.6-1.6"></path>
            </svg>
          </span>
          <span class="brand-text">Stop Calling It Green</span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-menu"
          aria-label="Open menu"
          data-nav-toggle
        >
          <svg class="icon-menu" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
        <div id="site-menu" class="site-menu" data-site-menu>
          <nav class="site-nav" aria-label="Primary">
            <div class="chapter-menu" data-chapter-menu>
              <button
                class="chapter-menu-button"
                type="button"
                aria-expanded="false"
                aria-controls="chapter-panel"
                data-chapter-toggle
              >
                <span>Chapters</span>
                <svg class="chapter-menu-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
              </button>
              <div id="chapter-panel" class="chapter-panel" data-chapter-panel>
                <ol>
                  {chapters.map((item) => (
                    <li>
                      <a
                        href={`/chapters/${item.slug}/`}
                        aria-current={item.slug === currentSlug ? "page" : undefined}
                        data-chapter-link={item.slug}
                      >
                        <span class="num">{chapterNumber(item)}</span>
                        <span class="name">{item.shortTitle}<span class="done" data-read-badge hidden>read</span></span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
            <a href="/about/">About</a>
          </nav>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme">
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2.5M12 19.5V22M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12H22M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.3 14.4A7.4 7.4 0 0 1 9.6 3.7 8.6 8.6 0 1 0 20.3 14.4Z"></path>
            </svg>
          </button>
        </div>
      </div>
      {resolvedKind === "chapter" && (
        <div class="read-progress" aria-hidden="true"><div class="read-progress-bar" data-progress-bar></div></div>
      )}
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer-grid">
          <div>
            <a class="brand" href="/">
              <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="4"></circle>
                  <path d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M5.6 18.4l1.6-1.6M16.8 7.2l1.6-1.6"></path>
                </svg>
              </span>
              <span class="brand-text">Stop Calling It Green</span>
            </a>
            <p class="site-footer-blurb">
              A free online book about how cheap power got dragged into the culture war. Self-funded, open source, and built to be checked.
            </p>
          </div>
          <div>
            <h2>Chapters</h2>
            <ol>
              {chapters.map((item) => (
                <li>
                  <a href={`/chapters/${item.slug}/`}><span class="num">{chapterNumber(item)}</span>{item.shortTitle}</a>
                </li>
              ))}
            </ol>
          </div>
          <div>
            <h2>Project</h2>
            <ul>
              <li><a href="/about/">About the book</a></li>
              <li><a href="https://github.com/ricokahler/stopcallingitgreen.org">Source on GitHub</a></li>
              <li><a href="https://github.com/ricokahler/stopcallingitgreen.org/issues">Send a correction</a></li>
              <li><a href="/#chapters">Table of contents</a></li>
            </ul>
          </div>
        </div>
        <div class="site-footer-bottom">
          <p>{editionLabel} · Written with heavy AI assistance and human responsibility.</p>
          <p>No donations, no merch, no organization.</p>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector("[data-nav-toggle]");
        const menu = document.querySelector("[data-site-menu]");
        const chapterMenu = document.querySelector("[data-chapter-menu]");
        const chapterToggle = document.querySelector("[data-chapter-toggle]");

        const closeChapters = () => {
          if (!chapterMenu || !chapterToggle) return;
          chapterMenu.removeAttribute("data-open");
          chapterToggle.setAttribute("aria-expanded", "false");
        };

        if (toggle && menu) {
          const closeNav = () => {
            toggle.setAttribute("aria-expanded", "false");
            toggle.setAttribute("aria-label", "Open menu");
            menu.removeAttribute("data-open");
            root.removeAttribute("data-nav-open");
            closeChapters();
          };
          toggle.addEventListener("click", () => {
            const open = toggle.getAttribute("aria-expanded") === "true";
            if (open) return closeNav();
            toggle.setAttribute("aria-expanded", "true");
            toggle.setAttribute("aria-label", "Close menu");
            menu.setAttribute("data-open", "");
            root.setAttribute("data-nav-open", "");
          });
          menu.addEventListener("click", (event) => {
            if (event.target instanceof Element && event.target.closest("a")) closeNav();
          });
          window.addEventListener("keydown", (event) => {
            if (event.key === "Escape") closeNav();
          });
        }

        if (chapterMenu && chapterToggle) {
          chapterToggle.addEventListener("click", () => {
            const open = chapterToggle.getAttribute("aria-expanded") === "true";
            chapterToggle.setAttribute("aria-expanded", String(!open));
            chapterMenu.toggleAttribute("data-open", !open);
          });
          document.addEventListener("click", (event) => {
            if (event.target instanceof Node && !chapterMenu.contains(event.target)) closeChapters();
          });
          window.addEventListener("keydown", (event) => {
            if (event.key === "Escape") closeChapters();
          });
        }

        // Theme toggle: light <-> dark, remembered per browser.
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const themeButton = document.querySelector("[data-theme-toggle]");
        const applyTheme = (theme, persist) => {
          root.dataset.theme = theme;
          root.dataset.themeMode = persist ? theme : "system";
          if (themeButton) {
            themeButton.setAttribute("aria-label", theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
          }
          if (persist) {
            try {
              localStorage.setItem("scig-theme", theme);
            } catch {}
          }
        };
        applyTheme(root.dataset.theme || "light", false);
        if (themeButton) {
          themeButton.addEventListener("click", () => {
            applyTheme(root.dataset.theme === "dark" ? "light" : "dark", true);
          });
        }
        media.addEventListener?.("change", () => {
          if (root.dataset.themeMode === "system") applyTheme(media.matches ? "dark" : "light", false);
        });

        // Read-state badges in the chapter menu.
        try {
          const read = JSON.parse(localStorage.getItem("scig-read") || "{}");
          document.querySelectorAll("[data-chapter-link]").forEach((link) => {
            if (read[link.dataset.chapterLink]) {
              const badge = link.querySelector("[data-read-badge]");
              if (badge) badge.hidden = false;
            }
          });
        } catch {}

        // Reveal-on-scroll.
        const revealed = document.querySelectorAll(".reveal");
        if (revealed.length && "IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-in");
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
          );
          revealed.forEach((element) => io.observe(element));
        } else {
          revealed.forEach((element) => element.classList.add("is-in"));
        }
      })();
    </script>
  </body>
</html>
